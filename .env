# PostgreSQL Database URL (DATABASE_URL pooled, DIRECT_URL direct for migrations)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/chitrabazaar?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/chitrabazaar?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="chitrabazaar-neo-brutalism-super-secret-key-2026"

# Demo Logins (Gated: only displayed when not production or when flag is true)
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="true"

# Localization & Currency
NEXT_PUBLIC_DEFAULT_CURRENCY="$"
NEXT_PUBLIC_APP_NAME="Chitrabazaar"

# Storage Service ('local', 's3', 'cloudinary')
STORAGE_PROVIDER="local"
NEXT_PUBLIC_STORAGE_PROVIDER="local"

# Payment Gateway ('mock', 'stripe', 'razorpay')
PAYMENT_GATEWAY="mock"
NEXT_PUBLIC_PAYMENT_GATEWAY="mock"

# Optional Cloud Storage Credentials
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# AWS_BUCKET_NAME=""
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
