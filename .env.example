# ==============================================================================
# Chitrabazaar Zero-Cost DevOps Configuration Matrix
# ==============================================================================

# Database: Neon Serverless PostgreSQL
# DATABASE_URL: Pooled endpoint (PgBouncer mode) used by Next.js and worker processes
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/chitrabazaar?sslmode=require&pgbouncer=true"
# DIRECT_URL: Direct unpooled endpoint (port 5432) used exclusively by Prisma Migrate
DIRECT_URL="postgresql://user:password@ep-sample.region.neon.tech/chitrabazaar?sslmode=require"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"

# Feature Flags & Demos
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="true"
NEXT_PUBLIC_DEFAULT_CURRENCY="$"
NEXT_PUBLIC_APP_NAME="Chitrabazaar"

# Cloudflare R2 Object Storage (Zero-Trust direct browser PUT & signed master GET)
STORAGE_PROVIDER="s3"
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="chitrabazaar-media"
CLOUDFLARE_R2_PUBLIC_URL="https://media.chitrabazaar.com"

# Payment Gateways (Stripe & eSewa)
PAYMENT_GATEWAY="stripe" # 'stripe', 'esewa', or 'mock'
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
ESEWA_MERCHANT_ID="EPAYTEST"
ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q"
ESEWA_GATEWAY_URL="https://rc-epay.esewa.com.np/api/epay/main/v2/form"
